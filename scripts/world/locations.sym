pub enum Interaction {
    Disabled = 0,
    Active = 1,
    Blocked = 2,
}
pub fn set_interaction(location: Location, state: Interaction) {
    world::set_interaction(i32(location), i32(state));
}
pub fn model(location: Location, model: markers::Model) {
    world::set_model(i32(location), i32(model));
}
pub fn hide(location: Location) {
    world::hide_marker(i32(location));
}
pub fn unmodeled(location: Location) {
    world::unmodeled_marker(i32(location));
}
pub fn visited(location: Location) -> bool {
    return world::visited(i32(location));
}
pub fn blocked(location: Location) -> bool {
    return world::blocked(i32(location));
}
// Contiguous catalogue ranges are converted only here, never in story rules.
pub fn discoveries(first: Location, last: Location) {
    for key in i32(first) .. i32(last) + 1 {
        let available = !world::visited(key) && world::party_available(key);
        if available {
            world::set_interaction(key, i32(Interaction::Active));
        } else {
            world::set_interaction(key, i32(Interaction::Disabled));
        }
    }
}
pub fn record_range(key: i32, first: Location, last: Location) -> bool {
    return key >= i32(first) && key <= i32(last);
}
pub fn refresh_guideposts() {
    for index in 0 .. world::guidepost_count() {
        if world::guidepost_known(index) {
            world::set_interaction(world::guidepost_location(index), i32(Interaction::Blocked));
        }
    }
}
