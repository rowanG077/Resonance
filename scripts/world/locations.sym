script library;
use std::world::WorldInteraction;
use std::locations::WorldLocationId;
use game::world;
use std::world::SylvarantMarkerId;
use std::world::TetheAllaMarkerId;
// World-event registry, from the cooked location catalogue.
pub fn set_interaction(location: WorldLocationId, state: WorldInteraction) {
    world::set_interaction(i32(location), i32(state));
}
pub fn sylvarant_model(location: WorldLocationId, model: SylvarantMarkerId) {
    world::set_model(i32(location), i32(model));
}
pub fn tethe_alla_model(location: WorldLocationId, model: TetheAllaMarkerId) {
    world::set_model(i32(location), i32(model));
}
pub fn hide(location: WorldLocationId) {
    world::hide_marker(i32(location));
}
pub fn unmodeled(location: WorldLocationId) {
    world::unmodeled_marker(i32(location));
}
pub fn visited(location: WorldLocationId) -> bool {
    return world::visited(i32(location));
}
pub fn blocked(location: WorldLocationId) -> bool {
    return world::blocked(i32(location));
}
// Contiguous catalogue ranges are converted only here, never in story rules.
pub fn discoveries(first: WorldLocationId, last: WorldLocationId) {
    for key in i32(first) .. i32(last) + 1 {
        let available = !world::visited(key) && world::party_available(key);
        if available {
            world::set_interaction(key, i32(WorldInteraction::Active));
        } else {
            world::set_interaction(key, i32(WorldInteraction::Disabled));
        }
    }
}
pub fn record_range(key: i32, first: WorldLocationId, last: WorldLocationId) -> bool {
    return key >= i32(first) && key <= i32(last);
}
pub fn refresh_guideposts() {
    for index in 0 .. world::guidepost_count() {
        if world::guidepost_known(index) {
            world::set_interaction(world::guidepost_location(index), i32(WorldInteraction::Blocked));
        }
    }
}
