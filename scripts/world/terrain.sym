script library;
use game::world;
use std::world::WorldId;
use world::locations;
use std::locations::WorldLocationId;
use world::story;
use std::story::StoryStage;
use world::quests;
use std::story::GlobalId;
use std::story::QuestStep;
struct LandmarkTile {
    location: WorldLocationId,
    column: i32,
    row: i32,
}
pub fn select(realm: WorldId) {
    if realm == WorldId::TetheAlla {
        if story::reached(StoryStage::UnknownId22601000) {
            world::alternate_tile(5, 5);
            world::alternate_tile(6, 5);
        }
        return;
    }
    // Cooked tile coordinates share the access state of their landmark.
    let tiles = [LandmarkTile {
        location: WorldLocationId::ThodaGeyser, column: 10, row: 8 }, LandmarkTile {
        location: WorldLocationId::TrietRuins, column: 0, row: 6 }, LandmarkTile {
        location: WorldLocationId::TrietRuins, column: 0, row: 7 }, LandmarkTile {
        location: WorldLocationId::Palmacosta, column: 5, row: 7 }, LandmarkTile {
        location: WorldLocationId::Palmacosta, column: 6, row: 7 }, LandmarkTile {
        location: WorldLocationId::BalacrufMausoleum, column: 10, row: 2 }, LandmarkTile {
        location: WorldLocationId::BalacrufMausoleum, column: 11, row: 2 }, LandmarkTile {
        location: WorldLocationId::TowerOfMana, column: 6, row: 0 }, LandmarkTile {
        location: WorldLocationId::AsgardRanch, column: 7, row: 0 },];
    for tile in tiles {
        if locations::blocked(tile.location) {
            world::alternate_tile(tile.column, tile.row);
        }
    }
    if quests::reached(GlobalId::PalmacostaRanchAssaultRoute, QuestStep::UnknownId10000) || quests::reached(GlobalId::PalmacostaRanchDorrRoute, QuestStep::PalmacostaDorrRouteComplete) {
        world::alternate_tile(9, 6);
    }
}
