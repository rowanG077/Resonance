script library;
use std::world::CaravanStopId;
use std::items::ItemId;
use std::world::SylvarantMarkerId;
use world::locations;
use std::locations::WorldLocationId;
use std::world::WorldInteraction;
use world::flags;
use std::story::StoryFlag;
use world::quests;
use std::story::GlobalId;
use std::story::QuestStep;
use world::story;
use std::story::StoryStage;
use world::items;
use std::world::WorldId;
// Each stop's discriminant is its landmark ID.
state stop: CaravanStopId = CaravanStopId::Triet;
pub fn on_enter(world: WorldId) {
    if world != WorldId::Sylvarant || !flags::enabled(StoryFlag::CaravanRoaming) {
        return;
    }
    match stop {
        CaravanStopId::Triet => {
            stop = CaravanStopId::Hima;
        },
        CaravanStopId::Hima => {
            stop = CaravanStopId::LakeUmacy;
        },
        CaravanStopId::LakeUmacy => {
            stop = CaravanStopId::Asgard;
        },
        CaravanStopId::Asgard => {
            stop = CaravanStopId::Palmacosta;
        },
        CaravanStopId::Palmacosta => {
            stop = CaravanStopId::Triet;
        },
    }
}
fn camp(location: WorldLocationId, available: bool) {
    if available {
        locations::set_interaction(location, WorldInteraction::Active);
        locations::sylvarant_model(location, SylvarantMarkerId::NovasCaravan);
    } else {
        locations::set_interaction(location, WorldInteraction::Disabled);
        locations::hide(location);
    }
}
pub fn refresh() {
    if flags::enabled(StoryFlag::CaravanRoaming) {
        for location in[WorldLocationId::NovasCaravan53, WorldLocationId::NovasCaravan54, WorldLocationId::NovasCaravan55, WorldLocationId::NovasCaravan57, WorldLocationId::NovasCaravan58, WorldLocationId::NovasCaravan60] {
            camp(location, i32(location) == i32(stop));
        }
        return;
    }
    let has_balacruf_map = items::count(ItemId::MapOfBalacruf) == 1;
    let has_desian_orb = items::count(ItemId::DesianOrb) != 0;
    let has_unicorn_horn = items::count(ItemId::UnicornHorn) == 1;
    let before_asgard_camp = story::before(StoryStage::MithosPanpipeReceived);
    let northern_journey = story::reached(StoryStage::UnisonAttackTutorialComplete);
    let ranch_not_cleared = quests::through(GlobalId::PalmacostaRanchDorrRoute, QuestStep::PalmacostaDorrRouteComplete);
    camp(WorldLocationId::NovasCaravan53, story::reached(StoryStage::IseliaExile) && story::before(StoryStage::TrietWantedPostersSeen));
    camp(WorldLocationId::NovasCaravan54, flags::enabled(StoryFlag::DevilsArmAcquired) && story::after(StoryStage::IseliaRanchRescueComplete));
    let hima_unicorn_phase = quests::at(GlobalId::Hima, QuestStep::UnknownId301);
    let before_unicorn_phase = quests::before(GlobalId::Hima, QuestStep::UnknownId301);
    let before_book_quest = quests::before(GlobalId::BookOfRegeneration, QuestStep::UnknownId1000);
    let missing_balacruf_map = items::count(ItemId::MapOfBalacruf) == 0;
    let northern_hima_route = northern_journey && ranch_not_cleared && missing_balacruf_map;
    let hima_camp =(northern_hima_route && before_book_quest) || hima_unicorn_phase;
    let lake_camp =(has_balacruf_map && !has_desian_orb) ||(has_unicorn_horn && before_unicorn_phase);
    camp(WorldLocationId::NovasCaravan55, before_asgard_camp && hima_camp);
    camp(WorldLocationId::NovasCaravan57, before_asgard_camp && lake_camp);
    camp(WorldLocationId::NovasCaravan58, !before_asgard_camp && quests::before(GlobalId::LinkiteTree, QuestStep::UnknownId40000));
    camp(WorldLocationId::NovasCaravan60, northern_journey && before_asgard_camp && ranch_not_cleared);
}
