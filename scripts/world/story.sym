script library;
use std::story::StoryStage;
use std::story::GlobalId;
use game::world;
// Story values are ordered save-data milestones. Their cutscene identities
// have not been established; do not infer names from a visibility side effect.
pub fn at(stage: StoryStage) -> bool {
    return world::global(i32(GlobalId::Story)) == i32(stage);
}
pub fn before(stage: StoryStage) -> bool {
    return world::global(i32(GlobalId::Story)) < i32(stage);
}
pub fn through(stage: StoryStage) -> bool {
    return world::global(i32(GlobalId::Story)) <= i32(stage);
}
pub fn after(stage: StoryStage) -> bool {
    return world::global(i32(GlobalId::Story)) > i32(stage);
}
pub fn reached(stage: StoryStage) -> bool {
    return world::global(i32(GlobalId::Story)) >= i32(stage);
}
