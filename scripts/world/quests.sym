script library;
use std::story::QuestStep;
use std::story::GlobalId;
use game::world;
pub fn at(quest: GlobalId, step: QuestStep) -> bool {
    return world::global(i32(quest)) == i32(step);
}
pub fn before(quest: GlobalId, step: QuestStep) -> bool {
    return world::global(i32(quest)) < i32(step);
}
pub fn through(quest: GlobalId, step: QuestStep) -> bool {
    return world::global(i32(quest)) <= i32(step);
}
pub fn reached(quest: GlobalId, step: QuestStep) -> bool {
    return world::global(i32(quest)) >= i32(step);
}
