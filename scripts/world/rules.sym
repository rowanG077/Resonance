script field;
use std::music::MusicId;
use std::world::MusicBankId;
use std::world::MountId;
use std::world::WorldId;
use std::locations::WorldLocationId;
use std::world::WorldInteraction;
use std::world::SylvarantMarkerId;
use std::world::TetheAllaMarkerId;
use std::story::StoryFlag;
use std::story::GlobalId;
use std::story::QuestStep;
use std::story::StoryStage;
use world::locations;
use world::flags;
use world::quests;
use world::story;
use world::caravan;
use world::terrain;
// IDs cross the native boundary only in the typed data modules.
fn enable(location: WorldLocationId, available: bool) {
    if available {
        locations::set_interaction(location, WorldInteraction::Active);
    } else {
        locations::set_interaction(location, WorldInteraction::Disabled);
    }
}
fn block(location: WorldLocationId, blocked: bool) {
    if blocked {
        locations::set_interaction(location, WorldInteraction::Blocked);
    } else {
        locations::set_interaction(location, WorldInteraction::Active);
    }
}
fn event(location: WorldLocationId, available: bool) {
    enable(location, available);
    if available {
        locations::unmodeled(location);
    } else {
        locations::hide(location);
    }
}
fn update_towns_and_dungeons() {
    if quests::before(GlobalId::LuinRebuilding, QuestStep::UnknownId1000) {
        locations::sylvarant_model(WorldLocationId::Luin7, SylvarantMarkerId::Luin);
    } else if quests::before(GlobalId::LuinRebuilding, QuestStep::UnknownId10000) {
        locations::sylvarant_model(WorldLocationId::Luin7, SylvarantMarkerId::LuinRuins);
    } else if quests::before(GlobalId::LuinRebuilding, QuestStep::UnknownId40000) {
        locations::sylvarant_model(WorldLocationId::Luin7, SylvarantMarkerId::LuinRebuilding);
    } else if quests::before(GlobalId::LuinRebuilding, QuestStep::UnknownId600000) {
        locations::sylvarant_model(WorldLocationId::Luin7, SylvarantMarkerId::Luin);
    } else {
        locations::sylvarant_model(WorldLocationId::Luin7, SylvarantMarkerId::LuinRebuilt);
    }
    if story::reached(StoryStage::IseliaExile) && story::before(StoryStage::UnknownId1208000) {
        locations::sylvarant_model(WorldLocationId::Iselia, SylvarantMarkerId::IseliaDamaged);
    } else {
        locations::sylvarant_model(WorldLocationId::Iselia, SylvarantMarkerId::Iselia);
    }
    if story::reached(StoryStage::OzetteAttack) {
        locations::tethe_alla_model(WorldLocationId::Ozette, TetheAllaMarkerId::OzetteDestroyed);
    } else {
        locations::tethe_alla_model(WorldLocationId::Ozette, TetheAllaMarkerId::Ozette);
    }
    for location in[WorldLocationId::Palmacosta, WorldLocationId::TrietRuins, WorldLocationId::ThodaGeyser, WorldLocationId::BalacrufMausoleum, WorldLocationId::TowerOfMana] {
        block(location, story::reached(StoryStage::UnknownId20201000));
    }
    block(WorldLocationId::AsgardRanch, quests::reached(GlobalId::AsgardRanch, QuestStep::UnknownId6000));
    enable(WorldLocationId::TowerOfSalvation24, story::before(StoryStage::ManaCannonFired));
    if story::before(StoryStage::ManaCannonFired) {
        locations::sylvarant_model(WorldLocationId::TowerOfSalvation24, SylvarantMarkerId::TowerOfSalvation);
    } else {
        locations::hide(WorldLocationId::TowerOfSalvation24);
    }
    block(WorldLocationId::TowerOfSalvation280, story::before(StoryStage::ZelosCruxisCrystalRecovered));
    if story::reached(StoryStage::UnknownId22601000) {
        locations::tethe_alla_model(WorldLocationId::TowerOfSalvation280, TetheAllaMarkerId::TowerOfSalvationLate);
    } else {
        locations::tethe_alla_model(WorldLocationId::TowerOfSalvation280, TetheAllaMarkerId::TowerOfSalvation);
    }
    if quests::reached(GlobalId::LinkiteTree, QuestStep::UnknownId40000) {
        locations::sylvarant_model(WorldLocationId::LinkiteTree, SylvarantMarkerId::LinkiteTreeRestored);
    } else {
        locations::sylvarant_model(WorldLocationId::LinkiteTree, SylvarantMarkerId::LinkiteTreeDormant);
    }
    if story::after(StoryStage::UnknownId20801000) {
        locations::set_interaction(WorldLocationId::IslandRanch, WorldInteraction::Blocked);
        locations::sylvarant_model(WorldLocationId::IslandRanch, SylvarantMarkerId::ManaCannon);
    } else {
        locations::set_interaction(WorldLocationId::IslandRanch, WorldInteraction::Disabled);
        locations::unmodeled(WorldLocationId::IslandRanch);
    }
}
fn update_story_events() {
    event(WorldLocationId::Skit00, story::before(StoryStage::IseliaExile));
    event(WorldLocationId::Skit01, story::reached(StoryStage::IseliaExile) && story::before(StoryStage::TrietWantedPostersSeen) && !locations::visited(WorldLocationId::Skit01));
    event(WorldLocationId::Skit02, story::reached(StoryStage::UnknownId1101000) && story::through(StoryStage::UnknownId1201000) && !locations::visited(WorldLocationId::Skit02));
    event(WorldLocationId::Skit03, story::reached(StoryStage::UnknownId1208000) && story::through(StoryStage::GuardTechniqueTutorialComplete));
    event(WorldLocationId::ExSkillTutorialEvent, story::reached(StoryStage::IseliaExile) && story::before(StoryStage::FirstCampComplete));
    event(WorldLocationId::OzetteAttackEvent, story::at(StoryStage::OzetteAttack));
    event(WorldLocationId::OtherworldlyGate, story::at(StoryStage::OtherworldlyGateSearch));
    if story::reached(StoryStage::RheairdsRecovered) && story::through(StoryStage::UnknownId12400000) {
        locations::set_interaction(WorldLocationId::FlyingDragon, WorldInteraction::Blocked);
        locations::tethe_alla_model(WorldLocationId::FlyingDragon, TetheAllaMarkerId::FlyingDragon);
    } else {
        locations::set_interaction(WorldLocationId::FlyingDragon, WorldInteraction::Disabled);
        locations::hide(WorldLocationId::FlyingDragon);
    }
    for location in[WorldLocationId::SylvarantBase, WorldLocationId::TetheallaBase] {
        if story::reached(StoryStage::RheairdsDimensionalTravelUnlocked) {
            if location == WorldLocationId::SylvarantBase {
                locations::sylvarant_model(location, SylvarantMarkerId::Portal);
            } else {
                locations::tethe_alla_model(location, TetheAllaMarkerId::Portal);
            }
        } else {
            locations::hide(location);
        }
    }
}
fn update_discoveries() {
    locations::discoveries(WorldLocationId::SylvarantExploration00Genis, WorldLocationId::SylvarantExploration31SandWorm);
    locations::discoveries(WorldLocationId::TetheallaExploration00Item, WorldLocationId::TetheallaExploration31Item);
    if quests::at(GlobalId::Hima, QuestStep::UnknownId301) {
        for location in[WorldLocationId::SylvarantExploration03Colette, WorldLocationId::SylvarantExploration16Colette, WorldLocationId::SylvarantExploration24Colette] {
            enable(location, false);
        }
    }
    enable(WorldLocationId::TetheallaExploration12Kratos, !locations::visited(WorldLocationId::TetheallaExploration12Kratos) && story::before(StoryStage::SeekingZelosCruxisCrystal));
    if story::through(StoryStage::PreseaAwakened) {
        enable(WorldLocationId::TetheallaExploration20Presea, false);
        enable(WorldLocationId::TetheallaExploration24Presea, false);
    }
    if !flags::enabled(StoryFlag::SandWormSightingHeard) || !flags::enabled(StoryFlag::CursedSwordRumorHeard) {
        enable(WorldLocationId::SylvarantExploration31SandWorm, false);
    }
    locations::refresh_guideposts();
}
pub fn refresh() {
    caravan::refresh();
    update_towns_and_dungeons();
    update_story_events();
    update_discoveries();
}
pub fn on_enter(world: WorldId) {
    caravan::on_enter(world);
}
pub fn records_visit(location: i32) -> bool {
    return locations::record_range(location, WorldLocationId::SylvarantExploration00Genis, WorldLocationId::Skit03) || locations::record_range(location, WorldLocationId::TetheallaExploration00Item, WorldLocationId::TetheallaExploration31Item);
}
pub fn music(mount: MountId, bank: MusicBankId) -> MusicId {
    if mount == MountId::Ship {
        return MusicId::TripOnTheShip;
    }
    if mount == MountId::Rheairds {
        return MusicId::AviatorsRheaBird;
    }
    if bank == MusicBankId::TetheAlla {
        return MusicId::WalkingOnTetheAlla;
    }
    return MusicId::TheLandOfSylvarant;
}
pub fn terrain_variants(world: WorldId) {
    terrain::select(world);
}
