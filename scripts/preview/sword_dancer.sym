script model;
use model;
use game::story;
use std::story::StoryFlag;
use std::model_nodes;
pub fn apply() {
    if !story::flag(i32(StoryFlag::SwordDancerTailVisible)) {
        model::set_scale(model::node(model_nodes::SwordDancerTail), 0.0, 0.0, 0.0);
    }
    if !story::flag(i32(StoryFlag::SwordDancerWingsVisible)) {
        model::set_scale(model::node(model_nodes::SwordDancerLeftWing), 0.0, 0.0, 0.0);
        model::set_scale(model::node(model_nodes::SwordDancerRightWing), 0.0, 0.0, 0.0);
    }
}
