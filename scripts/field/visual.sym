script library;
use game::effects::Sprite;
use game::effects::Image;
use game::effects::Color;
use game::effects::Blend;
use game::effects::SpriteBlend;
use game::effects::Fade;
use game::effects::Facing;
use game::effects::Anchor;
use game::geometry::Vector;
pub fn zero() -> Vector {
    return Vector {
        x: 0.0,
        y: 0.0,
        z: 0.0 };
}
pub fn neutral() -> Color {
    return Color {
        red: 64,
        green: 64,
        blue: 64 };
}
pub fn sprite(image: Image, lifetime: ticks, size: f32) -> Sprite {
    return Sprite {
        image: image,
        facing: Facing::Camera,
        anchor: Anchor::Center,
        lifetime: lifetime,
        width: size,
        height: size,
        growth: 0.0,
        offset: zero(),
        rotation: zero(),
        velocity: zero(),
        inherit_velocity: 0.0,
        angular_velocity: zero(),
        gravity: 0.0,
        palette: 0,
        color: neutral(),
        alpha: 128,
        fade: Fade::Tail,
        blend: SpriteBlend::Custom(Blend::Additive),
        field_lighting: false,
    };
}
