script library;
use field::ring_common;
use game::actors;
use game::audio;
use game::camera;
use game::camera::Fog;
use game::effects::Color;
use game::field;
use game::ring;
use game::ring::Hit;
enum Clip {
    Cast = 52 }
enum Cue {
    Prepare = 31,
    Launch = 263 }
const Windup: ticks = 20ticks;
const Recovery: ticks = 30ticks;
const Duration: i32 = 600;
const RampInEnd: i32 = 570;
const RampOutStart: i32 = 30;
const HideRemaining: i32 = 15;
const FogStart: f32 = 9900.0;
const FogEnd: f32 = 10000.0;
const FogStep: f32 = 326.6666564941406;
const Volume: i32 = 64;
fn fog(distance: f32) -> Fog {
    return Fog {
        start: distance,
        end: FogEnd,
        color: Color {
            red: 10,
            green: 255,
            blue: 10 }
    };
}
task reveal(enabled: bool) {
    if enabled {
        await ring::hit(Hit::Pulse);
    }
}
task hide() {
    await ring::end();
}
task scan(effect: camera::FogEffect) -> f32 {
    let mut remaining = Duration;
    let mut distance = FogStart;
    while remaining > HideRemaining {
        if field::event_paused() {
            return distance;
        }
        // Native inclusive ramp-in and exclusive ramp-out retain 31/29 updates.
        if remaining >= RampInEnd {
            distance -= FogStep;
        } else if remaining < RampOutStart {
            distance += FogStep;
        }
        camera::set_fog(effect, fog(distance));
        remaining -= 1;
        await field::next_update();
    }
    return distance;
}
pub task cast() {
    let pose = actors::play_service_clip(actors::controlled(), i32(Clip::Cast));
    let recovery = spawn ring_common::recover_control(pose, Recovery);
    audio::sound(i32(Cue::Prepare));
    await field::wait_ticks(Windup);
    audio::sound_volume(i32(Cue::Launch), Volume);
    await field::next_update();
    let effect = camera::fog(fog(FogStart));
    let revealed = spawn reveal(!field::event_paused());
    let mut distance = await scan(effect);
    let hidden = spawn hide();
    let mut remaining = HideRemaining;
    while remaining > 0 {
        distance += FogStep;
        camera::set_fog(effect, fog(distance));
        remaining -= 1;
        if remaining > 0 {
            await field::next_update();
        }
    }
    camera::finish_fog(effect);
    await hidden;
    await revealed;
    await recovery;
}
