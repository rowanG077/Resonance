script library;
use field::visual;
use field::ring_common;
use game::actors;
use game::audio;
use game::camera;
use game::effects;
use game::effects::Spark;
use game::effects::Color;
use game::effects::Image;
use game::effects::Blend;
use game::geometry::Vector;
use game::input;
use game::field;
use game::projectiles;
use game::projectiles::ActorScan;
use game::projectiles::Targets;
use game::ring;
use game::ring::Hit;
enum Clip {
    Idle = 12,
    Cast = 52,
    Stagger = 76 }
enum Cue {
    Prepare = 31,
    Place = 107,
    Blast = 194,
    Debris = 330 }
enum Scene {
    Controller = 99992,
    BombModel = - 1179636 }
const FirstMine: i32 = 412;
const LastMine: i32 = 415;
const Windup: ticks = 8ticks;
const Recovery: ticks = 30ticks;
const FuseUpdates: i32 = 180;
const BlastUpdates: i32 = 60;
const StaggerUpdates: i32 = 62;
const PlayerRadius: f32 = 120.0;
const EnemyRadius: f32 = 130.0;
const BodyRadius: f32 = 40.0;
const BurstHeight: f32 = 30.0;
const Gravity: f32 = - 0.98;
const FlameCount: i32 = 128;
const FlamePalette: i32 = 24;
const FlameColors: i32 = 7;
fn offset() -> Vector {
    return Vector {
        x: 0.0,
        y: 0.0,
        z: BurstHeight };
}
fn particle(shot: projectiles::Projectile, image: Image, palette: i32, life: ticks, size: f32, growth: f32, alpha: i32, velocity: Vector, spin: f32) {
    let mut sprite = visual::sprite(image, life, size);
    sprite.growth = growth;
    sprite.offset = offset();
    sprite.velocity = velocity;
    sprite.palette = palette;
    sprite.alpha = alpha;
    sprite.angular_velocity = Vector {
        x: 0.0,
        y: 0.0,
        z: spin };
    sprite.gravity = Gravity;
    effects::sprite(projectiles::effect(shot), sprite);
}
fn burst(shot: projectiles::Projectile) {
    let mut i = 0;
    while i < FlameCount {
        particle(shot, Image::Flame, FlamePalette + field::random(FlameColors), 70ticks, 50.0, 0.0, 192, Vector {
            x: f32(field::random(64) - 31) / 4.0, y: f32(field::random(64) - 31) / 4.0, z: f32(field::random(64)) / 4.0 + 10.0, }, f32(field::random(16) - 7));
        i += 1;
    }
    particle(shot, Image::Blast, 0, 30ticks, 1.0, 5.0, 192, visual::zero(), 0.0);
    particle(shot, Image::Blast, 2, 30ticks, 1.0, 5.0, 128, visual::zero(), 0.0);
}
fn glow(shot: projectiles::Projectile, red: bool) {
    let life = ticks(field::random(16) + 1);
    let mut size = f32(field::random(32) + 40);
    let mut growth = 6.0;
    let mut spin = 0.0;
    let mut color = Color {
        red: 255,
        green: 255,
        blue: 40 };
    if red {
        size = f32(field::random(64) + 200);
        growth = f32(field::random(8));
        spin = f32(field::random(8) - 3);
        color = Color {
            red: 255,
            green: 40,
            blue: 40 };
    }
    effects::spark(projectiles::effect(shot), Spark {
        lifetime: life, size: size, growth: growth, rotation: 0.0, spin: spin, velocity: visual::zero(), inherit_velocity: 0.0, color: color, offset: offset(), fade: - 8.0, alpha: 192, blend: Blend::Additive, });
}
fn remove_enemies(shot: projectiles::Projectile) {
    let mut scan = projectiles::overlapping(shot, EnemyRadius, Targets::All, ActorScan::Start);
    while true {
        match scan {
            ActorScan::After(actor) => {
                // Advance before removing the current actor from the scene.
                scan = projectiles::overlapping(shot, EnemyRadius, Targets::All, scan);
                if actors::is_enemy(actor) {
                    actors::despawn(actor);
                }
            },
            _ => {
                return;
            },
        }
    }
}
task stagger(shot: projectiles::Projectile) {
    if field::event_paused() || !projectiles::touches_actor(shot, actors::controlled(), PlayerRadius) {
        return;
    }
    let actor = actors::controlled();
    let mut clip = Clip::Stagger;
    if !actors::has_clip(actor, i32(clip)) {
        clip = Clip::Idle;
    }
    field::take_control();
    let pose = actors::play_clip(actor, i32(clip));
    let mut remaining = StaggerUpdates;
    while remaining > 0 {
        let mut color = Color {
            red: 66,
            green: 66,
            blue: 255 };
        if field::random(2) != 0 {
            color = Color {
                red: 191,
                green: 191,
                blue: 191 };
        }
        actors::tint(pose, color);
        await field::next_update();
        remaining -= 1;
    }
    actors::release_pose(pose);
    field::release_control();
}
task report(active: bool) {
    if active {
        await ring::hit(Hit::Pulse);
    }
}
pub task cast() {
    let map = field::map_id();
    if map < FirstMine || map > LastMine {
        return;
    }
    let actor = actors::controlled();
    let pose = actors::play_service_clip(actor, i32(Clip::Cast));
    let recovery = spawn ring_common::recover_control(pose, Recovery);
    audio::sound(i32(Cue::Prepare));
    await field::wait_ticks(Windup);
    let shot = projectiles::launch(actor, 0.0, 0.0, BodyRadius);
    projectiles::hold(shot);
    let bomb = actors::spawn(projectiles::effect(shot), actor, i32(Scene::Controller), i32(Scene::BombModel), BodyRadius);
    audio::sound(i32(Cue::Place));
    let mut fuse = FuseUpdates;
    while fuse > 0 {
        await field::next_update();
        if !field::event_paused() {
            fuse -= 1;
        }
    }
    actors::show(bomb, false);
    await field::next_update();
    audio::sound(i32(Cue::Blast));
    audio::sound(i32(Cue::Debris));
    input::rumble(8ticks);
    let active = !field::event_paused();
    if active {
        remove_enemies(shot);
    }
    let reaction = spawn stagger(shot);
    burst(shot);
    let callback = spawn report(active);
    let mut remaining = BlastUpdates;
    while remaining > 0 {
        if remaining >= 40 {
            glow(shot, true);
            glow(shot, false);
        }
        if !field::event_paused() {
            camera::shake(f32(remaining / 4), 8ticks, 8ticks);
        }
        remaining -= 1;
        await field::next_update();
    }
    projectiles::finish(shot);
    await callback;
    await reaction;
    await recovery;
}
