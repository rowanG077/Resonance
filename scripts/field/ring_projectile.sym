script library;
use game::actors;
use game::field;
use game::story;
use game::audio;
use game::party;
use game::projectiles;
use game::projectiles::Contact;
use game::projectiles::ActorScan;
use game::projectiles::Targets;
use game::projectiles::Motion;
use game::ring;
use game::ring::Hit;
use game::geometry::Vector;
use field::ring_sparks;
use field::ring_wind;
use field::ring_mana;
use field::ring_types::Shot;
enum Clip {
    Cast = 52,
}
enum Cue {
    Prepare = 31,
    Fire = 32,
    Water = 110,
    Wind = 87,
    Splash = 414,
    Mana = 270,
}
const Windup: ticks = 8ticks;
const Recovery: ticks = 30ticks;
const FlightLifetime: i32 = 20;
const LongFlightLifetime: i32 = 30;
const WindFlightLifetime: i32 = 30;
const ManaFlightLifetime: i32 = 60;
const LongDistance: f32 = 500.0;
const EnemyStun: ticks = 240ticks;
const FallbackMuzzleHeight: f32 = 100.0;
const MuzzleBone: string = "Bone_sebone03";
const Speed: f32 = 15.0;
const WindSpeed: f32 = 10.0;
const Radius: f32 = 20.0;
const RingLaunchFlag: i32 = 21;
const WaterLaunchVolume: i32 = 40;
const ManaLaunchVolume: i32 = 64;
const ManaCost: i32 = 10;
const ManaRecovery: ticks = 60ticks;
const ManaSpeed: f32 = 2.5;
task recover(pose: actors::Pose, kind: Shot) {
    let mut duration = Recovery;
    if kind == Shot::Mana {
        duration = ManaRecovery;
    }
    await field::wait_ticks(duration);
    actors::release_pose(pose);
    if kind == Shot::Wind || kind == Shot::LongRangeFire || kind == Shot::Mana {
        field::release_control();
    }
}
fn trail(shot: projectiles::Projectile, kind: Shot, age: i32) {
    match kind {
        Shot::Wind => {
            ring_wind::trail(shot, age);
        },
        Shot::Mana => {
            ring_mana::trail(shot, age);
        },
        _ => {
            ring_sparks::trail(shot, kind, age - 1);
        },
    }
}
fn finish(shot: projectiles::Projectile, kind: Shot, age: i32) {
    match kind {
        Shot::Wind => {
        },
        Shot::Mana => {
            ring_mana::burst(shot, age);
        },
        _ => {
            ring_sparks::burst(shot, kind);
        },
    }
    if kind == Shot::Water {
        audio::sound(i32(Cue::Splash));
    }
    projectiles::advance(shot);
    projectiles::finish(shot);
}
// Only the first foreground hit callback is accepted, but every touching
// enemy receives the fire stun in the native actor scan.
fn stun_contacts(shot: projectiles::Projectile, first: ActorScan) {
    let mut scan = first;
    let mut scanning = true;
    while scanning {
        match scan {
            ActorScan::After(actor) => {
                actors::stun(actor, EnemyStun, actors::StunEffect::None);
                scan = projectiles::overlapping(shot, Radius, Targets::All, scan);
            },
            _ => {
                scanning = false;
            },
        }
    }
}
task fly(shot: projectiles::Projectile, kind: Shot) {
    let mut lifetime = FlightLifetime;
    if kind == Shot::LongRangeFire {
        lifetime = LongFlightLifetime;
    }
    if kind == Shot::Wind {
        lifetime = WindFlightLifetime;
    }
    if kind == Shot::Mana {
        lifetime = ManaFlightLifetime;
    }
    let mut age = 0;
    while age < lifetime {
        await field::next_update();
        if kind == Shot::Fire {
            story::set_flag(RingLaunchFlag, false);
        }
        if field::event_paused() {
            projectiles::finish(shot);
            return;
        }
        age += 1;
        trail(shot, kind, age);
        if age < lifetime {
            let scan = projectiles::overlapping(shot, Radius, Targets::All, ActorScan::Start);
            match scan {
                ActorScan::After(actor) => {
                    if kind == Shot::Fire || kind == Shot::LongRangeFire {
                        stun_contacts(shot, scan);
                    }
                    finish(shot, kind, age);
                    await ring::hit(Hit::Actor(actor));
                    return;
                },
                _ => {
                },
            }
            match projectiles::contact(shot) {
                Contact::Barrier => {
                    finish(shot, kind, age);
                    return;
                },
                _ => {
                },
            }
        }
        // Expiry emits at the last origin without another contact query.
        if age == lifetime {
            finish(shot, kind, age);
            return;
        }
        projectiles::advance(shot);
    }
}
pub task cast(kind: Shot) {
    let actor = actors::controlled();
    if kind == Shot::Mana && !party::spend_tp(actor, ManaCost) {
        await ring::insufficient_tp();
        return;
    }
    let pose = actors::play_service_clip(actor, i32(Clip::Cast));
    let recovery = spawn recover(pose, kind);
    audio::sound(i32(Cue::Prepare));
    if kind == Shot::Fire {
        story::set_flag(RingLaunchFlag, false);
    }
    await field::wait_ticks(Windup);
    let height = actors::bone_height(actor, MuzzleBone, Vector {
        x: 0.0, y: 0.0, z: 0.0 }, FallbackMuzzleHeight);
    let mut speed = Speed;
    if kind == Shot::Wind {
        speed = WindSpeed;
    }
    if kind == Shot::LongRangeFire {
        speed = LongDistance / f32(LongFlightLifetime);
    }
    if kind == Shot::Mana {
        speed = ManaSpeed;
    }
    let shot = projectiles::launch(actor, height, speed, Radius);
    projectiles::motion(shot, Motion::Scripted);
    match kind {
        Shot::Fire => {
            audio::sound(i32(Cue::Fire));
            story::set_flag(RingLaunchFlag, true);
        },
        Shot::Water => {
            audio::sound_volume(i32(Cue::Water), WaterLaunchVolume);
        },
        Shot::Wind => {
            audio::sound(i32(Cue::Wind));
        },
        Shot::LongRangeFire => {
        },
        Shot::Mana => {
            audio::sound_volume(i32(Cue::Mana), ManaLaunchVolume);
        },
    }
    await fly(shot, kind);
    await recovery;
}
