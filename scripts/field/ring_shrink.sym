script library;
use field::ring_common;
use game::actors;
use game::audio;
use game::field;
use game::field::PlayerSize;
use game::ring;
use game::ring::Hit;
enum Clip {
    Cast = 52 }
enum Cue {
    Prepare = 31,
    Shrink = 287 }
const Recovery: ticks = 30ticks;
pub task cast() {
    let pose = actors::play_service_clip(actors::controlled(), i32(Clip::Cast));
    let recovery = spawn ring_common::recover_pose(pose, Recovery);
    audio::sound(i32(Cue::Prepare));
    match field::player_size() {
        PlayerSize::Normal => {
            field::set_player_size(PlayerSize::Small);
            audio::sound(i32(Cue::Shrink));
        },
        PlayerSize::Small => {
            field::set_player_size(PlayerSize::Normal);
        },
    }
    await ring::hit(Hit::Pulse);
    await recovery;
}
