script library;
use field::visual;
use game::field;
use game::effects;
use game::effects::Image;
use game::effects::Facing;
use game::effects::Fade;
use game::effects::Distortion;
use game::effects::DistortionImage;
use game::geometry::Vector;
use game::projectiles;
const DiscUpdate: i32 = 5;
const QuarterTurn: f32 = 90.0;
const DistortionPeriod: i32 = 4;
const StreaksPerUpdate: i32 = 2;
const Spread: i32 = 64;
const SpreadBias: i32 = 31;
const RecoilRange: i32 = 32;
const RecoilDivisor: f32 = 24.0;
const RecoilBias: f32 = - 0.8;
const RecoilInheritance: f32 = - 0.125;
enum Palette {
    White = 0,
    Wind = 28 }
fn jitter() -> f32 {
    return f32(field::random(Spread) - SpreadBias);
}
fn disc(shot: projectiles::Projectile, heading: f32, palette: Palette, alpha: i32, fade: f32) {
    let mut sprite = visual::sprite(Image::Disc, 8ticks, 48.0);
    sprite.facing = Facing::World;
    sprite.growth = 32.0;
    sprite.rotation = Vector {
        x: QuarterTurn,
        y: 0.0,
        z: heading };
    sprite.palette = i32(palette);
    sprite.alpha = alpha;
    sprite.fade = Fade::Linear(fade);
    effects::sprite(projectiles::effect(shot), sprite);
}
pub fn trail(shot: projectiles::Projectile, age: i32) {
    let heading = projectiles::heading(shot);
    if age == DiscUpdate {
        disc(shot, heading, Palette::White, 32, - 4.5);
        disc(shot, heading, Palette::Wind, 64, - 9.0);
    }
    if field::effect_tick() % DistortionPeriod == 0 {
        effects::distort(projectiles::effect(shot), Distortion {
            image: DistortionImage::Air, facing: Facing::Camera, lifetime: 16ticks, size: 96.0, growth: 0.0, rotation: Vector {
                x: 0.0, y: 0.0, z: QuarterTurn }, alpha: 128.0, fade: Fade::Tail, offset: visual::zero(), });
    }
    let mut count = 0;
    while count < StreaksPerUpdate {
        let mut sprite = visual::sprite(Image::Streak, 31ticks, 64.0);
        sprite.facing = Facing::World;
        sprite.height = 4.0;
        sprite.offset = Vector {
            x: jitter(),
            y: jitter(),
            z: jitter() };
        sprite.rotation = Vector {
            x: 0.0,
            y: 0.0,
            z: heading + QuarterTurn };
        sprite.inherit_velocity = - 0.5;
        sprite.palette = i32(Palette::White);
        sprite.alpha = 64;
        sprite.fade = Fade::Linear(- 4.25);
        effects::sprite(projectiles::effect(shot), sprite);
        count += 1;
    }
    projectiles::chain_impulse(shot, Vector {
        x: 0.0, y: 0.0, z: RecoilBias - f32(field::random(RecoilRange)) / RecoilDivisor, }, RecoilInheritance);
}
