script library;
use field::visual;
use game::field;
use game::audio;
use game::effects;
use game::effects::Image;
use game::effects::Fade;
use game::geometry::Vector;
use game::projectiles;
use field::ring_sparks;
enum Palette {
    Blue = 24,
    PaleBlue = 25 }
enum Cue {
    Shatter = 191 }
const ImpactVolume: i32 = 48;
const Shards: i32 = 16;
const Spread: i32 = 64;
const SpreadBias: i32 = 31;
const SizeRange: i32 = 4;
const ShardSize: i32 = 16;
const RotationRange: i32 = 256;
const Spin: f32 = 3.0;
const FallScale: f32 = 0.0078125;
const ShardLifetime: ticks = 61ticks;
const CoreSize: f32 = 64.0;
const CoreFade: f32 = - 4.25;
const TrailStarSize: f32 = 30.0;
const TrailStarRotation: f32 = 90.0;
const TrailStarLifetime: ticks = 3ticks;
fn jitter() -> f32 {
    return f32(field::random(Spread) - SpreadBias);
}
fn sprite(shot: projectiles::Projectile, image: Image, palette: Palette, life: ticks, size: f32, alpha: i32, fade: Fade, offset: Vector, angle: f32, spin: f32, fall: f32) {
    let mut sprite = visual::sprite(image, life, size);
    sprite.offset = offset;
    sprite.rotation = Vector {
        x: 0.0,
        y: 0.0,
        z: angle };
    sprite.velocity = Vector {
        x: 0.0,
        y: 0.0,
        z: fall };
    sprite.angular_velocity = Vector {
        x: 0.0,
        y: 0.0,
        z: spin };
    sprite.palette = i32(palette);
    sprite.alpha = alpha;
    sprite.fade = fade;
    effects::sprite(projectiles::effect(shot), sprite);
}
pub fn trail(shot: projectiles::Projectile, age: i32) {
    ring_sparks::frost(shot, age);
    sprite(shot, Image::Star, Palette::Blue, TrailStarLifetime, TrailStarSize, 192, Fade::Tail, visual::zero(), TrailStarRotation, 0.0, 0.0);
}
pub fn burst(shot: projectiles::Projectile) {
    let mut i = 0;
    while i < Shards {
        let mut palette = Palette::PaleBlue;
        if i % 2 != 0 {
            palette = Palette::Blue;
        }
        let offset = Vector {
            x: jitter(),
            y: jitter(),
            z: jitter() };
        let angle = f32(field::random(RotationRange));
        let mut spin = - Spin;
        if field::random(2) != 0 {
            spin = Spin;
        }
        sprite(shot, Image::Star, palette, ShardLifetime, f32(field::random(SizeRange) + ShardSize), 192, Fade::Tail, offset, angle, spin, - angle * FallScale);
        i += 1;
    }
    sprite(shot, Image::Orb, Palette::PaleBlue, ShardLifetime, CoreSize, 255, Fade::Linear(CoreFade), visual::zero(), 0.0, 0.0, 0.0);
    audio::sound_volume(i32(Cue::Shatter), ImpactVolume);
}
