script library;
use game::field;
use game::effects;
use game::effects::Spark;
use game::effects::Color;
use game::effects::Blend;
use game::geometry::Vector;
use game::projectiles;
const TrailPeriod: i32 = 4;
const CloudCount: i32 = 4;
const Spread: i32 = 32;
const OffsetBias: i32 = 15;
const MotionRange: i32 = 16;
const SpinBias: i32 = 7;
const SpinScale: f32 = 0.125;
const FallBase: f32 = - 0.2;
const FallScale: f32 = 0.03125;
const SizePerUpdate: f32 = 2.0;
const Shrink: f32 = 0.0625;
// Native particle timers include their zero frame.
const TrailLifetime: ticks = 121ticks;
const BurstLifetime: ticks = 241ticks;
const TrailTimer: f32 = 120.0;
const BurstTimer: f32 = 240.0;
const TrailFade: f32 = - 2.125;
const BurstFade: f32 = - 1.0;
enum Emission {
    Trail,
    Burst }
fn jitter() -> f32 {
    return f32(field::random(Spread) - OffsetBias);
}
fn clouds(shot: projectiles::Projectile, age: i32, emission: Emission) {
    let mut lifetime = TrailLifetime;
    let mut timer = TrailTimer;
    let mut fade = TrailFade;
    if emission == Emission::Burst {
        lifetime = BurstLifetime;
        timer = BurstTimer;
        fade = BurstFade;
    }
    let size = f32(age) * SizePerUpdate;
    let mut i = 0;
    while i < CloudCount {
        let offset = Vector {
            x: jitter(),
            y: jitter(),
            z: jitter() };
        let spin = f32(field::random(MotionRange) - SpinBias) * SpinScale;
        let mut fall = 0.0;
        if emission == Emission::Trail {
            fall = FallBase - f32(field::random(MotionRange)) * FallScale;
        }
        effects::spark(projectiles::effect(shot), Spark {
            lifetime: lifetime, size: size, growth: - size / timer * Shrink, rotation: 0.0, spin: spin, velocity: Vector {
                x: 0.0, y: 0.0, z: fall }, inherit_velocity: 0.0, color: Color {
                red: 0, green: 0, blue: 0 }, offset: offset, fade: fade, alpha: 255, blend: Blend::Alpha, });
        i += 1;
    }
}
pub fn trail(shot: projectiles::Projectile, age: i32) {
    if field::effect_tick() % TrailPeriod == 0 {
        clouds(shot, age, Emission::Trail);
    }
}
pub fn burst(shot: projectiles::Projectile, age: i32) {
    clouds(shot, age, Emission::Burst);
}
