script library;
use field::visual;
use game::field;
use game::effects;
use game::effects::Spark;
use game::effects::Color;
use game::effects::Blend;
use game::effects::Image;
use game::geometry::Vector;
use game::projectiles;
const TrailPeriod: i32 = 4;
const ParticleCount: i32 = 4;
const CloudSpread: i32 = 32;
const CloudBias: i32 = 15;
const ColorRange: i32 = 64;
const ColorBias: i32 = 22;
const MotionRange: i32 = 16;
const SpinBias: i32 = 7;
const SpinScale: f32 = 0.125;
const FallScale: f32 = 0.03125;
const FallBase: f32 = - 0.2;
const CloudGrowth: f32 = 2.0;
const CloudShrink: f32 = 0.0625;
const StarSize: i32 = 4;
const CloudAlpha: i32 = 128;
const CloudFade: f32 = - 2.0;
// Native timers retain their zero frame.
const CloudTrailLifetime: ticks = 61ticks;
const CloudBurstLifetime: ticks = 121ticks;
const StarTrailLifetime: ticks = 21ticks;
const StarBurstLifetime: ticks = 61ticks;
const CloudTrailTimer: f32 = 60.0;
const CloudBurstTimer: f32 = 120.0;
enum Palette {
    White = 0 }
enum Emission {
    Trail,
    Burst }
fn jitter() -> f32 {
    return f32(field::random(CloudSpread) - CloudBias);
}
fn fall() -> f32 {
    return FallBase - f32(field::random(MotionRange)) * FallScale;
}
fn color() -> i32 {
    return field::random(ColorRange) + ColorBias;
}
fn spread(age: i32) -> f32 {
    return f32(field::random(age * 2) - age);
}
fn particles(shot: projectiles::Projectile, age: i32, emission: Emission) {
    let mut cloud_lifetime = CloudTrailLifetime;
    let mut star_lifetime = StarTrailLifetime;
    let mut timer = CloudTrailTimer;
    if emission == Emission::Burst {
        cloud_lifetime = CloudBurstLifetime;
        star_lifetime = StarBurstLifetime;
        timer = CloudBurstTimer;
    }
    let size = f32(age) * CloudGrowth;
    let mut i = 0;
    while i < ParticleCount {
        let mut vertical = 0.0;
        if emission == Emission::Trail {
            vertical = fall();
        }
        effects::spark(projectiles::effect(shot), Spark {
            lifetime: cloud_lifetime, size: size, growth: - size / timer * CloudShrink, rotation: 0.0, spin: f32(field::random(MotionRange) - SpinBias) * SpinScale, velocity: Vector {
                x: 0.0, y: 0.0, z: vertical }, inherit_velocity: 0.0, color: Color {
                red: color(), green: color(), blue: color() }, offset: Vector {
                x: jitter(), y: jitter(), z: jitter() }, fade: CloudFade, alpha: CloudAlpha, blend: Blend::Alpha, });
        i += 1;
    }
    i = 0;
    while i < ParticleCount {
        let mut vertical = 0.0;
        if emission == Emission::Burst {
            vertical = fall();
        }
        let size = f32(field::random(MotionRange) + StarSize);
        let mut sprite = visual::sprite(Image::Star, star_lifetime, size);
        sprite.offset = Vector {
            x: spread(age),
            y: spread(age),
            z: spread(age) };
        sprite.rotation = Vector {
            x: 0.0,
            y: 0.0,
            z: f32(field::random(MotionRange) - SpinBias) };
        sprite.velocity = Vector {
            x: 0.0,
            y: 0.0,
            z: vertical };
        sprite.palette = i32(Palette::White);
        sprite.alpha = 255;
        effects::sprite(projectiles::effect(shot), sprite);
        i += 1;
    }
}
pub fn trail(shot: projectiles::Projectile, age: i32) {
    if field::effect_tick() % TrailPeriod == 0 {
        particles(shot, age, Emission::Trail);
    }
}
pub fn burst(shot: projectiles::Projectile, age: i32) {
    particles(shot, age, Emission::Burst);
}
