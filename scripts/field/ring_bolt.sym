script library;
use field::ring_common;
use game::actors;
use game::audio;
use game::field;
use game::geometry::Vector;
use game::projectiles;
use game::projectiles::Contact;
use game::projectiles::ActorScan;
use game::projectiles::Targets;
use game::projectiles::Motion;
use game::ring;
use game::ring::Hit;
use field::ring_lightning;
use field::ring_ice;
use field::ring_darkness;
pub enum Kind {
    Lightning,
    Ice,
    Darkness }
enum Clip {
    Cast = 52 }
enum Cue {
    Prepare = 31,
    Lightning = 42,
    Ice = 43,
    Darkness = 236 }
const Windup: ticks = 8ticks;
const Recovery: ticks = 30ticks;
const DarknessRecovery: ticks = 60ticks;
const FlightUpdates: i32 = 30;
const DarknessUpdates: i32 = 60;
const LightningReach: f32 = 400.0;
const Reach: f32 = 300.0;
const Radius: f32 = 20.0;
const EnemyStun: ticks = 240ticks;
const MuzzleBone: string = "Bone_sebone03";
const FallbackHeight: f32 = 100.0;
fn finish(shot: projectiles::Projectile, kind: Kind, age: i32) {
    if kind == Kind::Ice {
        ring_ice::burst(shot);
    }
    if kind == Kind::Darkness {
        ring_darkness::burst(shot, age);
    }
    projectiles::advance(shot);
    projectiles::finish(shot);
}
// The native event allocator accepts only the first foreground callback,
// but the controller still stuns every touching enemy in creation order.
fn stun_contacts(shot: projectiles::Projectile, first: ActorScan, kind: Kind) {
    let mut effect = actors::StunEffect::Lightning;
    if kind == Kind::Ice {
        effect = actors::StunEffect::Ice;
    }
    if kind == Kind::Darkness {
        effect = actors::StunEffect::Darkness;
    }
    let mut scan = first;
    let mut scanning = true;
    while scanning {
        match scan {
            ActorScan::After(actor) => {
                actors::stun(actor, EnemyStun, effect);
                scan = projectiles::overlapping(shot, Radius, Targets::All, scan);
            },
            _ => {
                scanning = false;
            },
        }
    }
}
task fly(shot: projectiles::Projectile, kind: Kind, duration: i32) {
    let mut age = 0;
    while age < duration {
        await field::next_update();
        if field::event_paused() {
            projectiles::finish(shot);
            return;
        }
        age += 1;
        match kind {
            Kind::Ice => {
                ring_ice::trail(shot, age - 1);
            },
            Kind::Lightning => {
                if age == 1 {
                    ring_lightning::draw(shot);
                }
            },
            Kind::Darkness => {
                ring_darkness::trail(shot, age);
            },
        }
        if age < duration {
            let scan = projectiles::overlapping(shot, Radius, Targets::All, ActorScan::Start);
            match scan {
                ActorScan::After(actor) => {
                    stun_contacts(shot, scan, kind);
                    finish(shot, kind, age);
                    await ring::hit(Hit::Actor(actor));
                    return;
                },
                _ => {
                },
            }
            match projectiles::contact(shot) {
                Contact::Barrier => {
                    finish(shot, kind, age);
                    return;
                },
                _ => {
                },
            }
        }
        if age == duration {
            finish(shot, kind, age);
            return;
        }
        projectiles::advance(shot);
    }
}
pub task cast(kind: Kind) {
    let mut duration = FlightUpdates;
    let mut recovery_time = Recovery;
    let mut reach = Reach;
    let mut cue = Cue::Ice;
    match kind {
        Kind::Lightning => {
            reach = LightningReach;
            cue = Cue::Lightning;
        },
        Kind::Ice => {
        },
        Kind::Darkness => {
            duration = DarknessUpdates;
            recovery_time = DarknessRecovery;
            cue = Cue::Darkness;
        },
    }
    let actor = actors::controlled();
    let pose = actors::play_service_clip(actor, i32(Clip::Cast));
    let recovery = spawn ring_common::recover_control(pose, recovery_time);
    audio::sound(i32(Cue::Prepare));
    await field::wait_ticks(Windup);
    let height = actors::bone_height(actor, MuzzleBone, Vector {
        x: 0.0, y: 0.0, z: 0.0 }, FallbackHeight);
    let shot = projectiles::launch(actor, height, reach / f32(duration), Radius);
    projectiles::motion(shot, Motion::Scripted);
    audio::sound(i32(cue));
    await fly(shot, kind, duration);
    await recovery;
}
