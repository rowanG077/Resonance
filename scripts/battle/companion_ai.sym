script battle;
use battle;

// 4E8C8 considers support targets before offensive techniques. Opening learned
// techniques cannot serve those groups, but target selection still consumes its
// original draws, including a random draw before lowest-HP target preference.
fn support_attempts(parameters: battle::CompanionParameters) {
    let mut dead = 0;
    let mut injured = 0;
    let mut available = 0;
    let mut petrified = 0;
    let mut index = 0;
    while index < battle::ally_count() {
        let actor = battle::ai_actor(battle::ally(index));
        if actor.dead { dead += 1; }
        if !actor.dead && actor.petrified { petrified += 1; }
        if actor.available {
            available += 1;
            if actor.hp_percent <= parameters.healing_limit { injured += 1; }
        }
        index += 1;
    }
    if dead != 0 { battle::ai_random_mod(dead); }
    if injured != 0 { battle::ai_random_mod(injured); }
    if petrified != 0 { battle::ai_random_mod(petrified); }
    if parameters.level_difference <= parameters.support_level_limit && available != 0 {
        battle::ai_random_mod(available);
    }
}

pub fn offensive_candidate(parameters: battle::CompanionParameters, retry: i32) -> i32 {
    if parameters.skill_policy == 5 { return -1; }
    support_attempts(parameters);
    // Cold preparation admits only the actual learned opening technique and
    // preserves its enabled state. The modulo-one draw is still observable.
    if parameters.technique_count == 0 { return -1; }
    let technique = battle::ai_companion_technique(0);
    let owner = battle::ai_actor(battle::owner());
    if !technique.enabled || owner.tp < technique.cost { return -1; }
    let target = battle::ai_actor(battle::target());
    if (retry & 8) != 0 && technique.learning_route != 2 { return -1; }
    if (retry & 4) != 0 && technique.learning_route != 1 { return -1; }
    battle::ai_random_mod(1);
    return 0;
}

fn allow_technique(parameters: battle::CompanionParameters, colette: bool) -> bool {
    // 4FE90 rejects Colette's non-casting opening arte before the first normal.
    if colette { return false; }
    let owner = battle::ai_actor(battle::owner());
    if owner.tp_percent > parameters.tp_limit { return true; }
    return battle::ai_random_mod(100) < 25;
}

fn normal_choice(parameters: battle::CompanionParameters, colette: bool) -> i32 {
    let mut choice = battle::ai_random_mod(4);
    let target = battle::ai_actor(battle::target());
    let owner = battle::ai_actor(battle::owner());
    if colette {
        choice = 2;
        if target.flying { choice = 3; }
        if target.height < 100.0 && owner.hp_percent >= 75 && battle::ai_body_gap() < 150.0 {
            choice = 0;
        }
    }
    return choice;
}

fn allow_chain(parameters: battle::CompanionParameters, combo: battle::CompanionCombo, colette: bool) -> bool {
    let tp = battle::ai_actor(battle::owner()).tp_percent;
    let ranged = colette && (combo.selection == 2 || combo.selection == 3);
    if ranged && (tp > parameters.tp_limit || battle::ai_random_mod(100) < 50) { return true; }
    if combo.index >= combo.limit - 1 {
        if tp > parameters.tp_limit || battle::ai_random_mod(100) < 25 { return true; }
    } else if parameters.level < 30 && battle::ai_random_mod(parameters.level / 2 + 1) == 0 {
        return true;
    }
    return ranged && (tp > parameters.tp_limit || battle::ai_random_mod(100) < 50);
}

// 4F3F0 flags0x11 excludes casting only after its random selection. Its
// preincremented attempt counter permits exactly nine draws, even modulo one.
fn chained_technique(parameters: battle::CompanionParameters, retry: i32) -> i32 {
    if parameters.technique_count == 0 { return -1; }
    let technique = battle::ai_companion_technique(0);
    if !technique.enabled || battle::ai_actor(battle::owner()).tp < technique.cost { return -1; }
    if (retry & 8) != 0 && technique.learning_route != 2 { return -1; }
    if (retry & 4) != 0 && technique.learning_route != 1 { return -1; }
    let mut attempt = 0;
    while attempt < 9 {
        battle::ai_random_mod(1);
        if (technique.flags & 128) == 0 { return technique.action; }
        attempt += 1;
    }
    return -1;
}

pub fn choose_chain(colette: bool) -> i32 {
    let parameters = battle::ai_companion_parameters();
    let combo = battle::ai_combo();
    let mut chosen = -1;
    if allow_chain(parameters, combo, colette) {
        let mut attempt = 0;
        while attempt < 100 {
            chosen = chained_technique(parameters, battle::ai_retry_flags());
            if chosen >= 0 && battle::ai_chain(chosen) { return chosen; }
            attempt += 1;
        }
    }
    if chosen >= 0 || combo.index >= combo.limit - 1 || combo.selection >= 5 { return -1; }
    let target = battle::ai_actor(battle::target());
    let mut next = battle::ai_random_mod(5);
    while next == 1 && target.height < 100.0 { next = battle::ai_random_mod(5); }
    if colette && next != 1 && combo.selection == 0 { next = 4; }
    let current = battle::ai_companion_normal(combo.selection);
    if (current.allowed & (1 << next)) == 0 {
        if current.fallback < 0 { return -1; }
        next = current.fallback;
    }
    let normal = battle::ai_companion_normal(next);
    battle::ai_chain(normal.action);
    return normal.action;
}

pub task combos(colette: bool) {
    while true {
        await battle::ai_combo_visit();
        choose_chain(colette);
    }
}

fn idle_pose(idle: battle::Motion, walk: battle::Motion, run: battle::Motion) {
    battle::forward_speed(0.0, false);
    if battle::motion_is(walk) || battle::motion_is(run) || battle::animation_finished() {
        battle::idle_pose(ticks(8));
    }
}

fn normal_fallback_allowed(parameters: battle::CompanionParameters, colette: bool) -> bool {
    if colette || parameters.technique_count == 0 { return true; }
    let owner = battle::ai_actor(battle::owner());
    let technique = battle::ai_companion_technique(0);
    // 1D26C counts learned and affordable techniques independently of enabled.
    if owner.tp < technique.cost || owner.tp_percent <= parameters.tp_limit { return true; }
    if parameters.position_policy != 4 && parameters.position_policy != 5 { return true; }
    let mut count = 0;
    let mut i = 0;
    while i < battle::ally_count() {
        if battle::ai_actor(battle::ally(i)).available { count += 1; }
        i += 1;
    }
    return count <= 1;
}

pub task ordinary(colette: bool, idle: battle::Motion, walk: battle::Motion, run: battle::Motion, stop: battle::Motion) {
    let parameters = battle::ai_companion_parameters();
    spawn combos(colette);
    spawn approaches(colette);
    while true {
        if battle::ai_idle_initializing() {
            battle::ai_reset_idle();
            idle_pose(idle, walk, run);
            battle::ai_face_current(180.0 / f32(parameters.turn_ticks));
        } else if battle::ai_ready() {
            let timer = battle::ai_idle_timer();
            if timer > 0 {
                battle::ai_set_idle_timer(timer - 2);
                idle_pose(idle, walk, run);
                battle::ai_face_target(180.0 / f32(parameters.turn_ticks));
            } else {
                battle::ai_set_target(battle::ai_select_target(parameters.target_policy));
                let retry = battle::ai_refresh_retry();
                let mut chosen = offensive_candidate(parameters, retry);
                if chosen < 0 && retry != 0 { chosen = offensive_candidate(parameters, 0); }
                if chosen >= 0 && allow_technique(parameters, colette) {
                    let technique = battle::ai_companion_technique(chosen);
                    battle::ai_request(technique.action, technique.minimum, technique.maximum,
                        run, stop, 0.5, parameters.speed, parameters.turn_ticks);
                } else {
                    battle::ai_set_target(battle::ai_select_target(parameters.target_policy));
                    let choice = normal_choice(parameters, colette);
                    if normal_fallback_allowed(parameters, colette) {
                        let normal = battle::ai_companion_normal(choice);
                        battle::ai_request(normal.action, normal.minimum, normal.maximum,
                            run, stop, 0.5, parameters.speed, parameters.turn_ticks);
                    } else if battle::ai_return_position() {
                        battle::play_motion(walk, ticks(4), 0.0, 0.5, true, 0.0);
                        battle::forward_speed(parameters.walk_speed, false);
                        battle::ai_face_direction(180.0 / f32(parameters.turn_ticks));
                    } else {
                        battle::ai_set_idle_timer(battle::ai_random_mod(15) + 30);
                        idle_pose(idle, walk, run);
                        battle::ai_face_current(180.0 / f32(parameters.turn_ticks));
                    }
                }
            }
        }
        await battle::next_update();
    }
}

// 298C0 invokes4E3D0 after in-range Auto admission; moving requests wait for
// 30C4C, before retreat/range checks. This callback shares the
// decision task tree but does not revisit ordinary next_update waiters.
pub task approaches(colette: bool) {
    while true {
        await battle::ai_approach_visit();
        let previous = battle::ai_approach_normal();
        let target = battle::ai_actor(battle::target());
        if previous != 1 {
            if target.height >= 100.0 { battle::ai_reselect_normal(1); }
        } else if target.height < 100.0 {
            let mut next = battle::ai_random_mod(4);
            while next == 1 { next = battle::ai_random_mod(4); }
            battle::ai_reselect_normal(next);
            // 34CC8 runs only after the downward transition for Colette.
            if colette {
                let parameters = battle::ai_companion_parameters();
                if parameters.position_policy == 2 || parameters.position_policy == 4 || parameters.position_policy == 5 {
                    next = 2;
                    if target.flying { next = 3; }
                    battle::ai_reselect_normal(next);
                } else if parameters.position_policy == 1 {
                    battle::ai_reselect_normal(0);
                }
                if battle::ai_actor(battle::owner()).hp_percent >= 75 && battle::ai_body_gap() < 150.0 {
                    battle::ai_reselect_normal(0);
                }
            }
        }
    }
}
