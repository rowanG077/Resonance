        "0x4258e3 movzx edx,byte ptr [eax+0x1ad] reads phase",
        "0x4258ea mov ecx,dword ptr [ecx*4+0x8e98d0] loads member handler table",
        "0x4258f1 mov edx,dword ptr [ecx+edx*4] loads phase handler",
        "0x4258f4 call edx"
      ],
      "controls": [
        {
          "source_technique_id": 30,
