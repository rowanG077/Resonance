      },
      "instructions": [
        "0x3a8a8 extsh r0,r5 (native action ID)",
        "0x3a8ac cmpwi r0,0xc8",
        "0x3a8d0 slwi r0,r0,2",
        "0x3a8dc add r6,r4,r0",
        "0x3a8e4 lwz r0,-0x320(r6) (table[(native-200)])",
        "0x3a8e8 stw r0,0(r29) (retain phase-handler table)",
        "0x3a944 phase-dispatch function begins",
        "0x3a950 lbz r0,0x34(r4) (phase)",
        "0x3a954 lwz r5,0(r4) (handler table)",
        "0x3a958 slwi r0,r0,2",
        "0x3a95c lwzx r12,r5,r0",
        "0x3a960 mtctr r12",
        "0x3a964 bctrl"
      ],
      "meaning": "Magic execution loads the selected handler table without a null fallback, then dereferences it to invoke the selected phase. Both audited slots are null in original source, unlike valid neighboring resident or stored spells.",
      "source": "gc_battle_rel"
    },
