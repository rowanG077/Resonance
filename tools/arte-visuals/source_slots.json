        "0x42539e mov dword ptr [eax],esi stores phase-handler table",
        "0x4253c8 or cl,1 enables the execution context",
        "0x4253d1 mov byte ptr [eax+0x34],0 starts phase0",
        "0x425319 movzx eax,byte ptr [ecx+0x34] reads active phase",
        "0x42531d mov edx,dword ptr [ecx] loads phase-handler table",
