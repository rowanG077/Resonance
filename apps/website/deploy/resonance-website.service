[Unit]
Description=Resonance website
Wants=network-online.target
After=network-online.target
ConditionFileIsExecutable=/opt/resonance-website/resonance-website

[Service]
Type=simple
User=resonance-website
Group=resonance-website
WorkingDirectory=/var/lib/resonance-website
StateDirectory=resonance-website
StateDirectoryMode=0750
Environment=RESONANCE_WEB_LISTEN=127.0.0.1:3000
Environment=RESONANCE_WEB_URL=https://resonance-project.net
Environment=RESONANCE_WEB_DATA=/var/lib/resonance-website
Environment=RESONANCE_WEB_REGISTRATION=false
Environment=RESONANCE_WEB_TRUSTED_PROXIES=127.0.0.1,::1
ExecStart=/opt/resonance-website/resonance-website
Restart=on-failure
RestartSec=5s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
