+std::string MemoryWatcher::ComposeMEM1Messages(const Core::CPUThreadGuard& guard)
+{
+  // Sorted location IDs replace repeated pointer expressions on the wire.
+  // The header is present on every real VI, including an unchanged row.
+  std::string message = "# mem1-v2\n1\n";
+  message.reserve(message.size() + m_values.size() * 8);
+  const auto append = [&message](u32 value) {
+    for (int shift = 24; shift >= 0; shift -= 8)
+      message.push_back(static_cast<char>((value >> shift) & 0xff));
+  };
+  if (m_invalid_location || m_values.size() >= 0x80000000)
+  {
+    append(0xffffffff);
+    append(0);
+    return message;
+  }
+
+  u32 id = 0;
+  for (auto& [address, current_value] : m_values)
+  {
+    const auto value = ChaseMEM1Pointer(guard, address);
+    if (!value)
+    {
+      append(id | 0x80000000);
+      append(0);
+      return message;
+    }
+    if (*value != current_value)
+    {
+      current_value = *value;
+      append(id);
+      append(*value);
+    }
+    ++id;
+  }
+  return message;
+}
