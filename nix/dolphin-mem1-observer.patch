+std::optional<u32> MemoryWatcher::ChaseMEM1Pointer(const Core::CPUThreadGuard& guard,
+                                                  const std::string& line)
+{
+  // This opt-in contract admits only physical MEM1 and its cached alias. It does
+  // not depend on the guest's temporary data-translation state at the VI boundary.
+  const auto physical = [](u64 address) -> std::optional<u32> {
+    if (address >= 0x80000000 && address <= 0x817ffffc)
+      address -= 0x80000000;
+    if (address > 0x017ffffc)
+      return std::nullopt;
+    return static_cast<u32>(address);
+  };
+  u32 value = 0;
+  const auto& offsets = m_addresses.at(line);
+  for (size_t index = 0; index < offsets.size(); ++index)
+  {
+    if (index != 0)
+    {
+      if (value == 0)
+        return 0;
+      if (!physical(value))
+        return std::nullopt;
+    }
+    const auto address = physical(static_cast<u64>(value) + offsets[index]);
+    if (!address)
+      return std::nullopt;
+    const auto result = PowerPC::MMU::HostTryRead<u32>(
+        guard, *address, PowerPC::RequestedAddressSpace::Physical);
+    if (!result)
+      return std::nullopt;
+    value = result->value;
+  }
+  return value;
+}
